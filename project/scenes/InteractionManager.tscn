[gd_scene load_steps=3 format=3 uid="uid://di22sihwx3y6j"]

[ext_resource type="FontFile" uid="uid://df2fko4bumdkn" path="res://assets/material/Characters/m6x11.ttf" id="1_10vj0"]

[sub_resource type="GDScript" id="GDScript_spka6"]
script/source = "extends Node2D

@onready var player = get_tree().get_first_node_in_group(\"player\")
@onready var label = $Label

const base_text = \"[E] to \"

var active_areas: Array[InteractionArea] = []
var can_interact: bool = true

func register_area(area: InteractionArea) -> void:
	if not active_areas.has(area):
		active_areas.append(area)

func unregister_area(area: InteractionArea) -> void:
	active_areas.erase(area)

func _process(_delta: float) -> void:
	if active_areas.size() > 0 and can_interact:
		active_areas.sort_custom(_sort_by_distance_to_player)
		var closest = active_areas[0]
		label.text = base_text + closest.action_name
		label.global_position = closest.global_position
		label.global_position.y -= 36
		label.global_position.x -= label.size.x / 2
		label.show()
	else:
		label.hide()

func _sort_by_distance_to_player(area1, area2) -> bool:
	var dist1 = player.global_position.distance_to(area1.global_position)
	var dist2 = player.global_position.distance_to(area2.global_position)
	return dist1 < dist2

func _input(event: InputEvent) -> void:
	if event.is_action_pressed(\"interact\") and can_interact:
		if active_areas.size() > 0:
			can_interact = false
			label.hide()
			
			await active_areas[0].interact.call()  # 调用书本的_open_book()
			
			can_interact = true
"

[node name="InteractionManager" type="Node2D"]
script = SubResource("GDScript_spka6")

[node name="Label" type="Label" parent="."]
z_index = 20
anchors_preset = 5
anchor_left = 0.5
anchor_right = 0.5
offset_left = -62.5
offset_right = 62.5
offset_bottom = 23.0
grow_horizontal = 2
theme_override_fonts/font = ExtResource("1_10vj0")
text = "[E]"
horizontal_alignment = 1
vertical_alignment = 1
