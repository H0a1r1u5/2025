[sub_resource type="Resource" id="Resource_kkuo2"]
script = ExtResource("5_onevj")
character_name = ""
content = "(The screen fades in. A dimly lit living room. The sound of rain outside. Mina and her mother stand facing each other.)"
metadata/_custom_type_script = "uid://dtpuy1fwyymfq"

[sub_resource type="Resource" id="Resource_3jlq0"]
script = ExtResource("5_onevj")
character_name = "Mother(Angery):"
content = " Mina, I’ve told you a hundred times—stop wasting your time with those drawings! You need to think about your future."
metadata/_custom_type_script = "uid://dtpuy1fwyymfq"

[sub_resource type="Resource" id="Resource_bscq4"]
script = ExtResource("5_onevj")
character_name = "Mina (defensive):"
content = " It’s not a waste of time! Drawing is the only thing that makes me feel alive. Why can’t you understand that?"
metadata/_custom_type_script = "uid://dtpuy1fwyymfq"

[sub_resource type="Resource" id="Resource_4jluf"]
script = ExtResource("5_onevj")
character_name = "Mother (snapping):"
content = " Because the real world doesn’t care about your silly dreams! You’re just being selfish."
metadata/_custom_type_script = "uid://dtpuy1fwyymfq"

[sub_resource type="Resource" id="Resource_ou25h"]
script = ExtResource("5_onevj")
character_name = "Mina (voice rising):"
content = " Selfish? You never listen to me! All you do is shout and tell me what I can’t do. Maybe I don’t want the life you chose for me!"
metadata/_custom_type_script = "uid://dtpuy1fwyymfq"

[sub_resource type="Resource" id="Resource_gjmvi"]
script = ExtResource("5_onevj")
character_name = "Mina (quiet, hurt):"
content = " I can’t stay here anymore.
"
metadata/_custom_type_script = "uid://dtpuy1fwyymfq"

[sub_resource type="Resource" id="Resource_jfxrs"]
script = ExtResource("5_onevj")
character_name = "Narration (Mina’s thoughts):"
content = " I don’t care where I go. I just need to get away. Away from her voice… away from this house… away from everything."
metadata/_custom_type_script = "uid://dtpuy1fwyymfq"

[sub_resource type="Resource" id="Resource_2t5jm"]
